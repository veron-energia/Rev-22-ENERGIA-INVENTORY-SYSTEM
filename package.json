{
  "name": "energia-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:phase4": "node scripts/phase4_acceptance.mjs",
    "test:customer-phones": "node --test scripts/customer-phones/tests/*.test.mjs",
    "test:survey": "node --test --test-timeout=20000 scripts/survey/tests/*.test.mjs",
    "test:customer-phones:db": "node scripts/customer-phones/tests/database.mjs",
    "test:auth-email": "node --test scripts/auth-email/tests/*.test.mjs",
    "test:auth-email:edge": "deno test --allow-env --allow-read supabase/functions/_shared/auth-email/tests/",
    "test:auth-email:db": "node scripts/auth-email/tests/database.mjs",
    "check:auth-email": "deno check supabase/functions/auth-signup-request/index.ts supabase/functions/auth-resend-verification/index.ts supabase/functions/auth-request-recovery/index.ts supabase/functions/auth-change-password/index.ts",
    "test:auth-email:delivery": "deno run --allow-net=127.0.0.1:8787 --allow-read --allow-write=scripts/auth-email/preview scripts/auth-email/local-delivery-check.ts",
    "check:deliverability": "sh scripts/auth-email/check-deliverability.sh",
    "test:invoice-dates": "node scripts/invoice-dates/tests/dates.test.mjs",
    "test:invoices": "node --test scripts/invoices/tests/*.test.mjs",
    "test:invoice-actions": "node --test scripts/invoice-actions/tests/*.test.mjs",
    "test:invoice-packages": "node --test scripts/invoice-packages/tests/*.test.mjs",
    "test:invoice-actions:concurrency": "node scripts/invoice-actions/tests/concurrency.mjs",
    "test:xero": "node --test scripts/xero/tests/*.test.mjs",
    "test:tiktok": "node --test scripts/tiktok/tests/*.test.mjs",
    "test:tiktok:db": "node scripts/tiktok/tests/database.mjs",
    "test:therapy": "node --test scripts/therapy/tests/*.test.mjs",
    "test:therapy:db": "node scripts/therapy/tests/database.mjs",
    "test:users:db": "node scripts/users/tests/database.mjs",
    "test:therapy-services:db": "node scripts/therapy-services/tests/database.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^30.0.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "libphonenumber-js": "1.13.12",
    "lucide-react": "^0.408.0",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
