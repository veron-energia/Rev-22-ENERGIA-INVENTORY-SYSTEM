{
  "name": "energia-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:phase4": "node scripts/phase4_acceptance.mjs",
    "test:customer-phones": "node --test scripts/customer-phones/tests/*.test.mjs",
    "test:survey": "node --test --test-timeout=20000 scripts/survey/tests/*.test.mjs",
    "test:customer-phones:db": "node scripts/customer-phones/tests/database.mjs",
    "test:auth-email": "node --test scripts/auth-email/tests/*.test.mjs",
    "test:auth-email:edge": "deno test --allow-env --allow-read supabase/functions/_shared/auth-email/tests/",
    "test:auth-email:db": "node scripts/auth-email/tests/database.mjs",
    "check:auth-email": "deno check supabase/functions/auth-signup-request/index.ts supabase/functions/auth-resend-verification/index.ts supabase/functions/auth-request-recovery/index.ts supabase/functions/auth-change-password/index.ts",
    "test:auth-email:delivery": "deno run --allow-net=127.0.0.1:8787 --allow-read --allow-write=scripts/auth-email/preview scripts/auth-email/local-delivery-check.ts",
    "check:deliverability": "sh scripts/auth-email/check-deliverability.sh",
    "test:invoice-dates": "node scripts/invoice-dates/tests/dates.test.mjs",
    "test:invoices": "node --test scripts/invoices/tests/*.test.mjs",
    "test:invoice-actions": "node --test scripts/invoice-actions/tests/*.test.mjs",
    "test:invoice-packages": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/invoice-packages/tests/create-overload-repair.sql",
    "test:invoice-payments": "node --test scripts/invoice-payments/tests/*.test.mjs",
    "test:exchanges": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/exchanges/tests/attribution.sql -f scripts/exchanges/tests/commission.sql -f scripts/exchanges/tests/instalments.sql",
    "test:affiliate-signup": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/affiliate-signup/tests/existing-customer-linking.sql -f scripts/affiliate-signup/tests/referral-and-states.sql -f scripts/affiliate-signup/tests/staff-cannot-self-issue.sql -f scripts/affiliate-signup/tests/onboarding-from-metadata.sql",
    "test:customer-merge": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/customer-merge/tests/merge-duplicates.sql",
    "test:invoice-list-refresh": "node --test scripts/invoices/tests/list-refresh.test.mjs && node scripts/invoices/tests/list-refresh-browser.mjs",
    "test:permissions": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/permissions/tests/function-grants.sql -f scripts/permissions/tests/role-guards.sql -f scripts/permissions/tests/rls-policies.sql -f scripts/permissions/tests/warehouse-stock-use.sql",
    "check:permissions": "ENERGIA_INVOICE_DB=energia_integration_test node scripts/permissions/client-rpcs-are-granted.mjs",
    "test:invoice-live": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/invoice-live/tests/publication.sql",
    "test:invoice-pagination": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/invoice-pagination/tests/list-page.sql -f scripts/invoice-pagination/tests/date-range.sql",
    "test:invoice-discounts": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/invoice-discounts/tests/manual-discount-reason.sql",
    "test:affiliate-directory": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/affiliate-directory/tests/staff-directory.sql",
    "test:save-earth": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/save-earth/tests/removed.sql",
    "test:quick-customer": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/quick-customer/tests/create-and-match.sql",
    "test:password-ui": "node --test scripts/ui/tests/*.test.mjs",
    "test:invoice-correction": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/invoice-correction/tests/affiliate-correction.sql -f scripts/invoice-correction/tests/promotion-voucher-ownership.sql -f scripts/invoice-correction/tests/reassignment-benefits.sql -f scripts/invoice-correction/tests/reassignment-owns-one-purchase.sql -f scripts/invoice-correction/tests/payment-corrections.sql",
    "test:therapy-choices": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/therapy-choices/tests/choice-packages.sql -f scripts/therapy-choices/tests/choice-at-till.sql -f scripts/therapy-choices/tests/switching-and-refunds.sql",
    "test:therapy-choices:concurrency": "node scripts/therapy-choices/tests/concurrency.mjs",
    "test:voucher-claims": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/voucher-claims/tests/deferred-claims.sql -f scripts/voucher-claims/tests/revocation-and-reconciliation.sql -f scripts/voucher-claims/tests/prior-issuance-counts.sql -f scripts/voucher-claims/tests/cancelled-offers-nothing.sql -f scripts/voucher-claims/tests/line-kind-rebuild.sql -f scripts/voucher-claims/tests/bundle-deferred-selection.sql -f scripts/voucher-claims/tests/negative-quantity.sql -f scripts/voucher-claims/tests/issued-once.sql",
    "test:commission-totals": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/commissions/tests/partial-payout-totals.sql",
    "test:commission-reinstall": "sh scripts/commissions/tests/reinstall-reearn.sh",
    "test:credit-policy": "ENERGIA_INVOICE_DB=energia_integration_test sh scripts/invoices/local-sql.sh -f scripts/credit-policy/tests/spending-rules.sql -f scripts/credit-policy/tests/snapshot-does-not-gate.sql -f scripts/credit-policy/tests/releases-as-it-is-paid.sql",
    "test:invoice-payments:concurrency": "node scripts/invoice-payments/tests/concurrency.mjs",
    "test:invoice-actions:concurrency": "node scripts/invoice-actions/tests/concurrency.mjs",
    "test:xero": "node --test scripts/xero/tests/*.test.mjs",
    "test:tiktok": "node --test scripts/tiktok/tests/*.test.mjs",
    "test:tiktok:db": "node scripts/tiktok/tests/database.mjs",
    "test:therapy": "node --test scripts/therapy/tests/*.test.mjs",
    "test:therapy:db": "node scripts/therapy/tests/database.mjs",
    "test:users:db": "node scripts/users/tests/database.mjs",
    "test:therapy-services:db": "node scripts/therapy-services/tests/database.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^30.0.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "libphonenumber-js": "1.13.12",
    "lucide-react": "^0.408.0",
    "papaparse": "^5.5.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
