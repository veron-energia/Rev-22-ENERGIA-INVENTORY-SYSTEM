# Copy to .env.local and fill in your own project's values:
#   cp .env.local.example .env.local
# .env.local is never committed. Only the PUBLIC anon key belongs here: never
# put a service-role key, a secret key or any other server-side value in a file
# the app reads (anything starting with VITE_ is shipped to every browser).
#
# Supabase dashboard -> Project Settings -> API.

# Your project's URL.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon (public) key.
VITE_SUPABASE_ANON_KEY=your-anon-public-key
